<!--
  This project is never built. `make` restores it once so that NuGet downloads
  the NativeAOT compiler (ILC) for us; the Makefile then runs ILC directly.
  It sits outside the RHOS projects' settings (see Directory.Build.props).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
